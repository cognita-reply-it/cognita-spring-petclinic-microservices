# Local template only. See docs/agent-readiness/setup.md before use.
# Spring Boot does not automatically read this file; export selected values.
# Compose reads .env for interpolation, but forwards only its declared keys.
CONFIG_SERVER_URL=http://localhost:8888/
# Optional: absolute directory for Config Server with native profile.
GIT_REPO=
# Required for real chat with the currently enabled OpenAI starter.
OPENAI_API_KEY=
# Only used after an intentional switch to the Azure OpenAI starter.
AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=
